  "narrative": {
    "northStar": "The Night Ledger",
    "overview": "Rekall is a ledger kept at night beside a terminal. Everything is a row in a table that answers one question, what waits for me, and the screen is dark so it does not compete with the session next to it. Colour is rationed: brushed gold marks where you are and what you do next, a single cool cyan marks the strings you copy, and green, yellow and red mean the state of a record and nothing else.",
    "keyCharacteristics": [
      "Dark only; the world is a blue-slate well with brushed-gold and cyan light.",
      "Three roles carry all colour: amber (here, next), cyan (anchors), status (record state).",
      "Tables and tabs over cards and panels; the status pill, the plan tube and the copy-anchor chip are the vocabulary every screen shares.",
      "Motion shows a state change or a session at work, and Reduced motion keeps every change."
    ],
    "rules": [
      {
        "name": "The One Amber Rule",
        "body": "On any screen exactly one thing is asking to be done, and it is the amber one. The review count is the only amber segment of the header capsule.",
        "section": "colors"
      },
      {
        "name": "The Cyan Is Copyable Rule",
        "body": "Cyan means an anchor you can paste after /rk. Do not use it for links, selection or decoration.",
        "section": "colors"
      },
      {
        "name": "The State Is Not Style Rule",
        "body": "Green, yellow and red describe a record. They never decorate a chart series, a tab or a button.",
        "section": "colors"
      },
      {
        "name": "The Eight Steps Rule",
        "body": "The type scale has eight sizes and none between them; a bracketed pixel size is a bug and design-tokens.spec.ts fails on it.",
        "section": "typography"
      },
      {
        "name": "The Subtle Floor Rule",
        "body": "Text never goes below Subtle in contrast, and an opacity modifier is never used to quieten it.",
        "section": "typography"
      },
      {
        "name": "The One Light Rule",
        "body": "One light source, top left, on every surface. A shadow that falls the other way is wrong.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep exactly one amber thing asking for action on a screen, and let the review count be the only amber segment of the header.",
      "Do show an anchor as a cyan Fira Code chip with a copy key, wherever a task, project or note is named.",
      "Do show a project's company beside its name wherever the name could be ambiguous.",
      "Do read sizes, radii, durations and colours from the tokens in main.css.",
      "Do make a state change visible without motion."
    ],
    "donts": [
      "Don't introduce a palette, a typeface or a new token family.",
      "Don't use amber, cyan or the status colours for decoration, series colours or selection that is not \"here\".",
      "Don't add a light theme or a mobile layout; both are out of scope.",
      "Don't put a bracketed font size, a bracketed radius or a numeric duration-* in a component.",
      "Don't let Claude's work read as accepted: only the console marks a step done."
    ]
  }
}
