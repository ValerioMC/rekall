# Root of the configuration tree: no lombok.config above this directory is consulted.
config.stopBubbling = true

# Marks generated methods with @lombok.Generated, which is what lets coverage tools skip
# accessors instead of reporting them as untested branches.
lombok.addLombokGeneratedAnnotation = true

# Field-level @Getter/@Setter only ever apply to the field they annotate. Without this, a
# @Setter on the class would also generate one for physical_name and column_name, and those
# are immutable by design: a diff cannot tell a rename from a drop plus an add.
lombok.setter.flagUsage = allow

# Never generate equals/hashCode/toString on entities implicitly. @Data is refused outright:
# on a JPA entity it walks lazy collections and breaks Set membership across a persist.
lombok.data.flagUsage = error
