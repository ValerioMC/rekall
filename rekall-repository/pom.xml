<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.rekall</groupId>
        <artifactId>rekall-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rekall-repository</artifactId>
    <name>rekall-repository</name>
    <description>Spring Data repositories and the Liquibase schema they read</description>

    <dependencies>
        <dependency>
            <groupId>dev.rekall</groupId>
            <artifactId>rekall-model</artifactId>
        </dependency>
        <!--
          The schema lives here, next to the repositories that depend on its shape, as
          db/changelog/**. Spring Boot 4 splits auto-configuration out of
          spring-boot-autoconfigure into per-technology modules: liquibase-core on the
          classpath is no longer enough to trigger it, spring-boot-liquibase is what
          registers LiquibaseAutoConfiguration.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <!--
          H2 on file. The schema is fixed and created by Liquibase at startup, so nothing here
          needs transactional DDL and the database can be a file next to the jar.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
