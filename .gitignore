# Build output, bundle del frontend incluso. Vite scrive in rekall-ui/dist e rekall-app lo
# incorpora nel binario in fase di compilazione.
target/
node_modules/
dist/

# Database locali (make run-demo scrive in ./data/demo), e i vecchi file H2 da importare.
data/
*.mv.db
*.trace.db
*.lock.db

# Database SQLite: rekall.db, piu' il suo WAL.
rekall.db
*.db-wal
*.db-shm
*.db.importing
*.db.restoring

# Segreti e configurazione locale.
.env
.env.*
!.env.example

# Tooling del frontend: vitest, vue-tsc, eslint, cache di vite.
coverage/
*.tsbuildinfo
.eslintcache
.vite/

# IntelliJ.
.idea/
*.iml

# Claude Code: i comandi sono condivisi, i settings locali no.
.claude/settings.local.json

# Sistema operativo ed editor.
.DS_Store
Thumbs.db
*.swp
*.log

# Prompt personale, non condiviso col repo.
/ui-prompt.md
