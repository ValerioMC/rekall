# Copy to .env.local and fill in. .env.local is gitignored and never committed.
#
# REKALL_READER_PASSWORD is the password of the read-only PostgreSQL role the MCP server
# authenticates as. Liquibase creates the role with it, and the application reads it back to
# open the MCP connection pool. There is no default anywhere in the code: an unresolved
# placeholder stops the application, which is the intended behaviour.

REKALL_DB_USER=rekall
REKALL_DB_PASSWORD=change-me
REKALL_READER_PASSWORD=change-me-too

# Only needed by `make run-local`, which talks to a port-forwarded database.
REKALL_DB_URL=jdbc:postgresql://localhost:5432/rekall
