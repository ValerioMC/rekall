{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "console",
  "description": "What the console, served by the local Rekall server, may ask of the window: the bridges, the window controls AnchorBar.vue draws itself and the in-app update install, nothing else.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-pick-folder",
    "allow-open-in-claude-code",
    "allow-notify",
    "allow-close-window",
    "allow-minimize-window",
    "allow-toggle-maximize-window",
    "allow-install-update",
    "allow-answer-leave"
  ]
}
